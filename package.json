{
  "name": "@michengai/dsh-code-review",
  "version": "0.1.2",
  "description": "基于 Codex 原版审查流程的 DSH 原生子 Agent 插件",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "assets/codex",
    "assets/branding",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && node scripts/check-docs.mjs",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-package.ps1",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-commands": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.6-alpha.1",
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichengAI/dsh-code-review.git"
  },
  "homepage": "https://github.com/MichengAI/dsh-code-review#readme",
  "bugs": {
    "url": "https://github.com/MichengAI/dsh-code-review/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
