{
  "name": "@michengai/dsh-code-review",
  "version": "0.1.7",
  "description": "DSH Code Review — 为 DeepSeek Harness 提供 Codex 风格代码审查、原生独立子 Agent、灵活范围选择和中英文报告 · Codex-style code review with native independent agents, flexible scope selection, and bilingual reports for DSH",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "assets/codex",
    "assets/branding",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && node scripts/check-docs.mjs",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-package.ps1",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-commands": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-user-questions": ">=0.1.7-rc.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "22.18.6",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichengAI/dsh-code-review.git"
  },
  "homepage": "https://github.com/MichengAI/dsh-code-review#readme",
  "bugs": {
    "url": "https://github.com/MichengAI/dsh-code-review/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
